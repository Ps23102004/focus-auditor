-}
\ No newline at end of file
+}
+
+// PLANTED BUGS (branch `buggy`): this row traps D-pad focus (exit is cancelled in every
+// direction) and contains two icon-only controls with no accessible name.
+@OptIn(ExperimentalTvMaterial3Api::class, ExperimentalComposeUiApi::class)
+@Composable
+fun QuickActions() {
+    Row(
+        modifier = Modifier
+            .padding(start = 8.dp, bottom = 24.dp)
+            .focusProperties { exit = { FocusRequester.Cancel } }
+            .focusGroup(),
+        horizontalArrangement = Arrangement.spacedBy(16.dp)
+    ) {
+        Button(onClick = { }) { Text("Play") }
+        IconTile()
+        IconTile()
+    }
+}
+
+@OptIn(ExperimentalTvMaterial3Api::class)
+@Composable
+fun IconTile() {
+    Surface(onClick = { }, modifier = Modifier.size(48.dp)) {
+        Box(modifier = Modifier.background(Red300).size(48.dp))
+    }
+}
